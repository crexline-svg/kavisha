# Copy this file to .env and edit as needed.

# ---------- General ----------
DEBUG=false
PIPELINE_VERSION=1.0.0

# ---------- Scraping ----------
# Marketplace root. Use the site matching your research region.
#   https://www.amazon.com  |  https://www.amazon.in  |  https://www.amazon.co.uk
MARKETPLACE=https://www.amazon.com

# Run the browser without a visible window. Set to false to watch/debug.
HEADLESS=true

# Use an installed Chrome instead of bundled Chromium (often less bot-flagged).
# BROWSER_CHANNEL=chrome

# Politeness delay between page loads (seconds). Do not lower these.
MIN_DELAY_S=1.5
MAX_DELAY_S=4.0

NAV_TIMEOUT_MS=45000
MAX_RETRIES=3

# Block images/fonts/css for much faster scraping.
BLOCK_RESOURCES=true

# Optional proxy, e.g. http://user:pass@host:port
# PROXY_SERVER=

# ---------- ABSA engine ----------
# auto   -> use LLM when LLM_API_KEY is set, else lexicon baseline
# llm    -> force LLM (Steps 3 & 4 of the methodology)
# lexicon-> force the rule-based baseline (no API key, offline)
ABSA_ENGINE=auto

# OpenAI-compatible endpoint. Examples:
#   OpenAI      : https://api.openai.com/v1              (LLM_MODEL=gpt-4o-mini)
#   OpenRouter  : https://openrouter.ai/api/v1
#   Groq        : https://api.groq.com/openai/v1
#   Ollama local: http://localhost:11434/v1              (LLM_API_KEY=ollama)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BATCH_SIZE=10
LLM_TIMEOUT_S=90
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.0

# ---------- Pipeline behaviour ----------
# core     -> battery, camera, display, performance, design, price
# extended -> core + software, connectivity, audio, durability
ASPECT_SET=core

LANGUAGE_FILTER=en
MIN_REVIEW_CHARS=15

# Aspect score = (positive + NEUTRAL_WEIGHT * neutral) / total
NEUTRAL_WEIGHT=0.5

# Aspects with fewer mentions than this are reported as low-confidence.
MIN_MENTIONS_FOR_SCORE=3

# Bayesian shrinkage strength pulling sparse aspects toward the corpus mean.
SHRINKAGE_STRENGTH=5.0
